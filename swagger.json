{
    "openapi": "3.0.0",
    "info": {
        "title": "Notetools API",
        "version": "2.0.1",
        "description": "API for de gerenciamento de pedidos"
    },
    "components": {
        "securitySchemes": {
            "cookieAuth": {
                "type": "apiKey",
                "in": "cookie",
                "name": "nt.authtoken"
            }
        },
        "schemas": {
            "User": {
                "type": "object",
                "required": [
                    "username",
                    "firstName",
                    "lastName",
                    "role",
                    "password"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid",
                        "description": "ID único do usuário"
                    },
                    "username": {
                        "type": "string",
                        "description": "Username do usuário"
                    },
                    "fisrtName": {
                        "type": "string",
                        "format": "string",
                        "description": "Nome do usuário"
                    },
                    "lastName": {
                        "type": "string",
                        "format": "string",
                        "description": "Sobrenome do usuário"
                    },
                    "role": {
                        "type": "string",
                        "format": "string",
                        "description": "Senha do usuário"
                    },
                    "password": {
                        "type": "string",
                        "format": "password",
                        "description": "Senha do usuário"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time",
                        "description": "Data de criação do usuário"
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "date-time",
                        "description": "Data de atualização do usuário"
                    }
                }
            },
            "Order": {
                "type": "object",
                "required": [
                    "id",
                    "number",
                    "local",
                    "schedulingDate",
                    "schedulingTime",
                    "price",
                    "status",
                    "contact",
                    "createdAt",
                    "updatedAt"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "number": {
                        "type": "integer"
                    },
                    "schedulingDate": {
                        "type": "string",
                        "format": "date"
                    },
                    "schedulingTime": {
                        "type": "string"
                    },
                    "price": {
                        "type": "integer"
                    },
                    "status": {
                        "type": "string"
                    },
                    "contact": {
                        "type": "string"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "Error": {
                "type": "object",
                "properties": {
                    "error": {
                        "type": "object",
                        "properties": {
                            "details": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "paths": {
        "/users": {
            "post": {
                "tags": ["Users"],
                "summary": "Criar novo usuário",
                "description": "Criação de novo usuário - Requer cargo de administrador",
                "security": [
                    {
                        "cookieAuth": ["nt.authtoken"]
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "username": {
                                        "type": "string",
                                        "description": "Username do usuário"
                                    },
                                    "firstName": {
                                        "type": "string",
                                        "description": "Nome do usuário"
                                    },
                                    "lastName": {
                                        "type": "string",
                                        "description": "Sobrenome do usuário"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "description": "Senha do usuário"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Usuário criado com sucesso"
                    },
                    "400": {
                        "description": "Dados inválidos",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "object",
                                            "properties": {
                                                "details": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string",
                                                        "description": "Detalhes do erro"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized - Token não localizado"
                    }
                }
            },
            "get": {
                "tags": ["Users"],
                "summary": "Listar usuários",
                "description": "Listagem de usuários - Requer cargo de administrador",
                "security": [
                    {
                        "cookieAuth": ["nt.authtoken"]
                    }
                ],
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Número da página para paginação",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 1
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "description": "Número de usuários por página",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 10
                        }
                    },
                    {
                        "name": "search",
                        "in": "query",
                        "description": "Busca os usuários pelo username, firstName e lastName",
                        "required": false
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lista paginada de usuários",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "users": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "id": {
                                                        "type": "string",
                                                        "format": "uuid",
                                                        "description": "ID único do usuário"
                                                    },
                                                    "username": {
                                                        "type": "string",
                                                        "description": "Username do usuário"
                                                    },
                                                    "firstName": {
                                                        "type": "string",
                                                        "description": "Nome do usuário"
                                                    },
                                                    "lastName": {
                                                        "type": "string",
                                                        "description": "Sobrenome do usuário"
                                                    },
                                                    "role": {
                                                        "type": "string",
                                                        "description": "Cargo do usuário"
                                                    },
                                                    "createdAt": {
                                                        "type": "string",
                                                        "format": "date-time",
                                                        "description": "Data de criação do usuário"
                                                    },
                                                    "updatedAt": {
                                                        "type": "string",
                                                        "format": "date-time",
                                                        "description": "Data de atualização do usuário"
                                                    }
                                                }
                                            }
                                        },
                                        "page": {
                                            "type": "integer",
                                            "description": "Número da página atual"
                                        },
                                        "totalItems": {
                                            "type": "integer",
                                            "description": "Total de usuários encontrados"
                                        },
                                        "totalPages": {
                                            "type": "integer",
                                            "description": "Total de páginas disponíveis"
                                        },
                                        "limit": {
                                            "type": "integer",
                                            "description": "Quantidade de usuários por página"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized - Invalid or missing token"
                    }
                }
            }
        },
        "/users/{id}": {
            "get": {
                "tags": ["Users"],
                "summary": "Buscar usuário",
                "description": "Buscar dados de usuário por id único",
                "security": [
                    {
                        "cookieAuth": ["nt.authtoken"]
                    }
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "params",
                        "description": "Id único do usuário",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Busca de usuário",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "id": {
                                            "type": "string",
                                            "format": "uuid",
                                            "description": "ID único do usuário"
                                        },
                                        "username": {
                                            "type": "string",
                                            "description": "Username do usuário"
                                        },
                                        "firstName": {
                                            "type": "string",
                                            "description": "Nome do usuário"
                                        },
                                        "lastName": {
                                            "type": "string",
                                            "description": "Sobrenome do usuário"
                                        },
                                        "role": {
                                            "type": "string",
                                            "description": "Cargo do usuário"
                                        },
                                        "createdAt": {
                                            "type": "string",
                                            "format": "date-time",
                                            "description": "Data de criação do usuário"
                                        },
                                        "updatedAt": {
                                            "type": "string",
                                            "format": "date-time",
                                            "description": "Data de atualização do usuário"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Usuário não localizado"
                    },
                    "401": {
                        "description": "Unauthorized - Invalid or missing token"
                    }
                }
            },
            "put": {
                "tags": ["Users"],
                "summary": "Atualizar usuário",
                "description": "Atualizar dados do usuário - Requer autenticação",
                "security": [
                    {
                        "cookieAuth": ["nt.authtoken"]
                    }
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "params",
                        "required": true
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "username": {
                                        "type": "string",
                                        "description": "Username do usuário"
                                    },
                                    "fisrtName": {
                                        "type": "string",
                                        "format": "string",
                                        "description": "Nome do usuário"
                                    },
                                    "lastName": {
                                        "type": "string",
                                        "format": "string",
                                        "description": "Sobrenome do usuário"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "204": {
                        "description": "Dados atualizados com sucesso"
                    },
                    "400": {
                        "description": "Dados inválidos",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "object",
                                            "properties": {
                                                "details": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string",
                                                        "description": "Detalhes do erro"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized - Token não localizado"
                    },
                    "404": {
                        "description": "Usuário não localizado"
                    }
                }
            },
            "delete": {
                "tags": ["Users"],
                "summary": "Excluir usuário",
                "description": "Excluir cadastro do usuário - Requer autenticação",
                "security": [
                    {
                        "cookieAuth": ["nt.authtoken"]
                    }
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "params",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Usuário deletado com sucesso!"
                    },
                    "404": {
                        "description": "Usuário não localizado"
                    },
                    "401": {
                        "description": "Unauthorized - Token não localizado"
                    },
                    "403": {
                        "description": "Usuário sem permissão para acessar essa rota"
                    }
                }
            }
        },
        "/users/update-password/{id}": {
            "put": {
                "tags": ["Users"],
                "summary": "Atualizar senha do usuário",
                "description": "Rota para atualizar a senha do usuário",
                "security": [
                    {
                        "cookieAuth": ["nt.authtoken"]
                    }
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "params",
                        "description": "Id único do usuário",
                        "required": true
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "currentPassword": {
                                        "type": "string"
                                    },
                                    "newPassword": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "204": {
                        "description": "Alteração de senha concluída"
                    },
                    "400": {
                        "description": "Dados inválidos",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "object",
                                            "properties": {
                                                "details": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string",
                                                        "description": "Detalhes do erro"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized - Token não localizado"
                    },
                    "404": {
                        "description": "Usuário não localizado"
                    }
                }
            }
        },
        "/orders/{userId}": {
            "post": {
                "tags": ["Pedidos"],
                "summary": "Criar pedido",
                "description": "Criação de um novo pedido",
                "security": [
                    {
                        "cookieAuth": ["nt.authtoken"]
                    }
                ],
                "parameters": [
                    {
                        "name": "userId",
                        "in": "params",
                        "required": true
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "number": {
                                        "type": "integer"
                                    },
                                    "local": {
                                        "type": "string"
                                    },
                                    "schedulingDate": {
                                        "type": "string",
                                        "format": "date"
                                    },
                                    "schedulingTime": {
                                        "type": "string"
                                    },
                                    "price": {
                                        "type": "integer",
                                        "format": "decimal"
                                    },
                                    "contact": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Pedido criado com sucesso"
                    },
                    "400": {
                        "description": "Dados inválidos",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "object",
                                            "properties": {
                                                "details": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Usuário não localizado"
                    },
                    "401": {
                        "description": "Unauthorized - Token não localizado"
                    }
                }
            }
        },
        "/orders/{id}": {
            "get": {
                "tags": ["Pedidos"],
                "summary": "Buscar pedido",
                "description": "Buscar pedido por id único",
                "security": [
                    {
                        "cookieAuth": ["nt.authtoken"]
                    }
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "params",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Pedido encontrado com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Order"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Pedido não localizado"
                    },
                    "401": {
                        "description": "Unauthorized - Token não localizado"
                    }
                }
            },
            "put": {
                "tags": ["Pedidos"],
                "summary": "Atualizar pedido",
                "description": "Atulizar dados do pedido - Requer autenticação",
                "security": [
                    {
                        "cookieAuth": ["nt.authtoken"]
                    }
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "params",
                        "description": "Id do pedido",
                        "required": true
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "number": {
                                        "type": "integer"
                                    },
                                    "local": {
                                        "type": "string"
                                    },
                                    "price": {
                                        "type": "integer"
                                    },
                                    "contact": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "204": {
                        "description": "Dados atualizados com sucesso"
                    },
                    "400": {
                        "description": "Dados inválidos",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Pedido não encontrado"
                    },
                    "401": {
                        "description": "Unauthorized - Token não localizado"
                    }
                }
            },
            "delete": {
                "tags": ["Pedidos"],
                "summary": "Excluir pedido",
                "description": "Excluir cadastro do pedido",
                "security": [
                    {
                        "cookieAuth": ["nt.authtoken"]
                    }
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "params",
                        "description": "Id do pedido",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Pedido excluido com sucesso"
                    },
                    "401": {
                        "description": "Unauthorized - Token não localizado"
                    },
                    "404": {
                        "description": "Pedido não encontrado"
                    }
                }
            }
        }
    }
}
